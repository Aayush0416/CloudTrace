DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudtrace"
# Use 32+ random characters: `openssl rand -hex 32`. The placeholder below is refused when NODE_ENV=production.
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Where verification links point (the frontend URL)
APP_URL="http://localhost:5173"
# Behind a reverse proxy, set the number of proxy hops (e.g. 1) so rate limits see real client IPs.
# TRUST_PROXY=1

# Google sign-in (optional). Create an OAuth client of type "Web application" in Google Cloud Console,
# add http://localhost:5173 as an Authorized JavaScript origin, and paste the client ID here.
GOOGLE_CLIENT_ID=

# Email delivery for verification links (optional). Without it, links are printed in this console.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CloudTrace <no-reply@cloudtrace.local>"

# AI assistant: "demo" (built in, no key needed) or "openai" (see below).
AI_PROVIDER=demo

# Local testing only: skip email verification entirely (ignored when NODE_ENV=production)
DEV_AUTO_VERIFY=false
# Real LLM: set AI_PROVIDER=openai and add a key. The key stays on the server. If the API fails, the demo engine answers instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
